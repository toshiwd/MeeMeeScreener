      "daily_gap_up_flag",
      "daily_gap_down_flag",
      "daily_engulfing_bull_flag",
      "daily_engulfing_bear_flag"
    ],
    "monthly_main_state": [
      "monthly_up_pre",
      "monthly_up_mid",
      "monthly_up_top_warning",
      "monthly_range_pre",
      "monthly_range_mid",
      "monthly_range_late",
      "monthly_down_mid",
      "monthly_down_bottom_warning"
    ],
    "weekly_main_state": [
      "weekly_up_early",
      "weekly_up_mid",
      "weekly_up_late",
      "weekly_range_mid",
      "weekly_range_late",
      "weekly_down_early",
      "weekly_down_mid",
      "weekly_down_bottom_warning"
    ]
  },
  "support_weight": 0.01,
  "top5_freeze_enabled": true
