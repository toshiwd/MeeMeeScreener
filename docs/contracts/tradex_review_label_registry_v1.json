{
  "schema_version": "tradex_review_label_registry_v1",
  "scope": "TRADEX review and research reporting labels only",
  "boundary": {
    "runtime_db_write": false,
    "production_ranking_mutation": false,
    "meemee_reflection": false,
    "english_ids_remain_authoritative_keys": true
  },
  "policy": {
    "purpose": "Map stable English IDs to Japanese display names for review and operator communication.",
    "usage_rule": "Use Japanese display_name in user-facing reports, while keeping english_id unchanged in code and artifacts unless explicitly promoted.",
    "non_scope": [
      "renaming production schema fields",
      "changing model feature names",
      "changing runtime DB columns",
      "changing existing authoritative artifact keys"
    ]
  },
  "pattern_labels": [
